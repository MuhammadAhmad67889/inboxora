# Copy this file to .env and fill in real values. Never commit .env.

# Database. Local dev uses a SQLite file; production (Neon) uses a
# postgresql:// URL. The Prisma schema is kept compatible with both.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies and hash tokens.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the app, used in password-reset and invite links.
APP_URL="http://localhost:3000"

# Optional: email sending for password resets and invites.
# Leave unset in local dev — reset/invite links are printed to the
# server console instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Phase 3: live AI reply drafts via a provider switch (all
# providers speak the OpenAI chat-completions shape; list from
# open-free-llm-api/awesome-freellm-apis). Free tiers change —
# re-check before relying on any of them.
#
# LLM_PROVIDER: groq (default) | mistral | openrouter | pollinations
#   groq        https://api.groq.com/openai/v1        (recommended:
#               free, no card; the key already used for
#               clientdesk-support in Vercel can be reused at deploy)
#   mistral     https://api.mistral.ai/v1
#   openrouter  https://openrouter.ai/api/v1          (LLM_MODEL required)
#   pollinations https://text.pollinations.ai/openai  (keyless,
#               best-effort only — slow/unreliable; enable ONLY by
#               setting LLM_PROVIDER=pollinations explicitly)
#
# Leave LLM_API_KEY empty (and no explicit pollinations) for
# clearly-labelled demo mode: drafts quote your FAQ entry's own
# text. With a key set, live failures are shown as errors — the
# app never silently falls back to demo text.
LLM_PROVIDER="groq"
LLM_API_KEY=""
# Optional: override the live model. Defaults: groq qwen/qwen3.8-27b
# (verified on Groq's free tier — do not use retired models),
# mistral mistral-small-latest, pollinations openai.
LLM_MODEL=""
# Legacy aliases still honoured: GROQ_API_KEY / GROQ_MODEL.
